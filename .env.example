# --- Database (Vercel Postgres injects these automatically when connected to the project) ---
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel Blob (auto-injected per store once connected to the project) ---
# Public store: template-tokri-blob-public — product preview images
# Private store: template-tokri-blob-pvt — delivered files & reference uploads
BLOB_READ_WRITE_TOKEN_PUBLIC=
BLOB_READ_WRITE_TOKEN_PVT=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@templatetokri.com
BREVO_SENDER_NAME=Template Tokri

# --- Notifications ---
ADMIN_NOTIFICATION_EMAIL=
